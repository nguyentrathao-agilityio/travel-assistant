# OpenAI API Key — required
OPENAI_API_KEY=sk-...

# OpenAI model — optional, defaults to openai/gpt-4o-mini
OPENAI_MODEL=openai/gpt-4o-mini


# PostgreSQL database — required for memory and storage
POSTGRES_URL=postgresql://user:password@localhost:5432/travel_assistant

# LangSmith tracing (optional) — auto-instruments via these env vars, no code changes needed.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=travel-planner-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Langfuse tracing (optional) — enabled only when both keys are present.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development

# Voice recordings (optional) — S3-compatible bucket (Railway Bucket or Cloudflare R2).
# On Railway, reference the bucket's variables, e.g. VOICE_BUCKET_NAME=${{Bucket.BUCKET}}.
# Without these, voice works but recordings are not saved.
# VOICE_BUCKET_NAME=
# VOICE_BUCKET_ENDPOINT=
# VOICE_BUCKET_REGION=auto
# VOICE_BUCKET_ACCESS_KEY_ID=
# VOICE_BUCKET_SECRET_ACCESS_KEY=
# VOICE_BUCKET_FORCE_PATH_STYLE=false
