{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:setup": "dotenv -e .env -- tsx src/scripts/setup-checkpointer.ts",
    "db:seed-knowledge": "dotenv -e .env -- tsx src/scripts/seed-knowledge.ts",
    "db:seed-knowledge:deploy": "tsx src/scripts/seed-knowledge.ts || true",
    "build": "tsc && tsc-alias",
    "dev": "tsc && tsc-alias && langgraphjs dev --port 8123 --no-browser",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/graph-integration.test.ts",
    "test:watch": "vitest",
    "test:evals": "vitest run src/evals/__tests__/regression-cases.test.ts",
    "test:evals:live": "dotenv -e .env -- vitest run -c vitest.config.evals.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.53",
    "@ag-ui/core": "^0.0.53",
    "@copilotkit/runtime": "^1.57.1",
    "@copilotkit/sdk-js": "1.57.1",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "~1.3.7",
    "@langchain/langgraph-checkpoint": "~1.0.4",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/langgraph-sdk": "^1.9.27",
    "@langchain/openai": "^1.4.7",
    "@langchain/textsplitters": "^1.0.1",
    "agentevals": "^0.0.7",
    "hono": "^4.12.30",
    "langchain": "^1.4.0",
    "openai": "^6.38.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.4.3",
    "@repo/schemas": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^4.1.9",
    "dotenv-cli": "^11.0.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.16.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
