{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:setup": "tsx src/scripts/setup-checkpointer.ts",
    "build": "tsc && tsc-alias",
    "dev": "tsc && tsc-alias && langgraphjs dev --port 8123 --no-browser",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:record": "RECORD=1 vitest run",
    "eval:dev": "SKIP_AIMOCK=1 evalite watch",
    "eval:run": "SKIP_AIMOCK=1 evalite run",
    "eval:serve": "SKIP_AIMOCK=1 evalite serve",
    "eval:ci": "evalite run",
    "eval:export": "evalite export --output eval-report",
    "aimock": "aimock --config aimock.json",
    "aimock:record": "aimock --config aimock.json --record"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.53",
    "@ag-ui/core": "^0.0.53",
    "@ag-ui/mastra": "^1.0.3",
    "@ai-sdk/openai": "^3.0.0",
    "@copilotkit/runtime": "^1.57.1",
    "@copilotkit/sdk-js": "1.57.1",
    "@hono/node-server": "^1.19.13",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.4",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/langgraph-sdk": "^1.9.27",
    "@langchain/openai": "^1.4.7",
    "@mastra/client-js": "^1.19.1",
    "@mastra/core": "^1.36.0",
    "@mastra/loggers": "^1.1.1",
    "@mastra/memory": "^1.19.0",
    "@mastra/observability": "^1.12.0",
    "@mastra/pg": "^1.11.1",
    "@mastra/rag": "^2.2.1",
    "ai": "^6.0.207",
    "dotenv": "^16.4.5",
    "hono": "^4.12.30",
    "langchain": "^1.4.0",
    "langsmith": "^0.8.3",
    "openai": "^6.38.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.31.0",
    "@langchain/langgraph-cli": "^1.4.3",
    "@repo/constants": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^4.1.9",
    "autoevals": "^0.3.0",
    "evalite": "^0.19.0",
    "mastra": "^1.0.0",
    "msw": "^2.14.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.16.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
