{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/typescript-config/node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/mastra/*"],
      "@langgraph/*": ["./src/langgraph/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", ".mastra"]
}
