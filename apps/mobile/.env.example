# Use an address reachable from the simulator or physical device.
# Physical device: replace with your computer's LAN IP.
EXPO_PUBLIC_RUNTIME_URL=http://192.168.1.100:8123/chat

# Optional per-platform overrides — win over EXPO_PUBLIC_RUNTIME_URL above, so
# you don't have to edit it every time you switch between simulator/emulator.
# iOS Simulator shares the Mac's network, so localhost works directly:
# EXPO_PUBLIC_RUNTIME_URL_IOS=http://localhost:8123/chat
# Android emulator's alias for the host machine's localhost:
# EXPO_PUBLIC_RUNTIME_URL_ANDROID=http://10.0.2.2:8123/chat

