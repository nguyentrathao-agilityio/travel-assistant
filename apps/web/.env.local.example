# CopilotKit runtime — served by apps/agent's LangGraph CopilotKit server (src/langgraph/server.ts)
VITE_RUNTIME_URL= http://localhost:4200/chat

# Mastra REST base — used by mastraClient (thread list, message fetch, etc.)
VITE_MASTRA_URL= http://localhost:4111

# CopilotKit public license key — required for premium features (e.g. useCopilotChatHeadless_c)
VITE_COPILOTKIT_PUBLIC_LICENSE_KEY=
