# Copy to .env and set a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# PostgreSQL connection for the app and Prisma CLI.
# Local Postgres:  postgresql://<user>@localhost:5432/nestjs_ai_training
# docker compose:  postgresql://postgres:postgres@localhost:5433/nestjs_ai_training
DATABASE_URL=

# Separate database for e2e tests; its name must end with `_test`
# (tests truncate every table in it).
TEST_DATABASE_URL=

# Admin account created by `pnpm db:seed`. Required, no defaults;
# password at least 8 characters. Re-running the seed does not change an
# existing Admin.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Swagger UI at /api/docs. Optional: on by default, off when
# NODE_ENV=production. Set to true or false to override.
SWAGGER_ENABLED=
